# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública de la app (para links de cotización y tienda)
NEXT_PUBLIC_SITE_URL=https://dulcesdetallesbyberealvarez.com
# Dominio principal: cada tienda queda en <tienda>.dulcesdetallesbyberealvarez.com
NEXT_PUBLIC_ROOT_DOMAIN=dulcesdetallesbyberealvarez.com
# (Opcional) valores de DNS que te muestre Vercel para dominios propios de clientas
# NEXT_PUBLIC_VERCEL_A=76.76.21.21
# NEXT_PUBLIC_VERCEL_CNAME=cname.vercel-dns.com

# Envío de cotizaciones por correo (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Dulces Detalles <cotizaciones@tudominio.com>"

# Resumen diario de entregas por correo (Vercel Cron, ver vercel.json)
# Supabase → Project Settings → API → service_role (¡secreta! nunca con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Cualquier texto largo y aleatorio; Supabase lo envía al ejecutar el cron
CRON_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Notificaciones push (app instalada). Genera las tuyas con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# CAPTCHA Cloudflare Turnstile (la "Secret key" va en Supabase → Attack Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Opcional: también manda los errores a Sentry (además del panel de administración)
SENTRY_DSN=
